  "components": [
    {
      "name": "Icon Button",
      "kind": "button",
      "refersTo": "icon-button",
      "description": "Quiet circular control; tonal fill on hover or active state.",
      "html": "<button class=\"ds-button ds-icon\" aria-label=\"Reset view\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M3 11a9 9 0 1 1 3 7M3 4v7h7\"/></svg></button>",
      "css": ".ds-icon{display:inline-flex;align-items:center;justify-content:center;padding:9px;color:#acc3b6;background:none;border:0;border-radius:50%;cursor:pointer;transition:color .2s,background .2s}.ds-icon:hover,.ds-icon[aria-pressed=true]{color:#eff5e8;background:#193029}.ds-button:focus-visible,.ds-link:focus-visible,.ds-input:focus-visible{outline:2px solid var(--copper,#efb093);outline-offset:6px}"
    },
    {
      "name": "Enter / Replay Action",
      "kind": "button",
      "refersTo": "enter-button",
      "description": "Text action with a fine circular arrow.",
      "html": "<button class=\"ds-button ds-enter\">Enter the cell <span><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M12 4v16m-6-6 6 6 6-6\"/></svg></span></button>",
      "css": ".ds-enter{display:inline-flex;align-items:center;gap:28px;font:400 12px 'DM Sans',sans-serif;letter-spacing:.01em;color:var(--ink,#e9eee6);padding:0;background:none;border:0;cursor:pointer}.ds-enter span{display:grid;place-items:center;width:38px;height:38px;border:1px solid #557261;border-radius:50%;transition:background .25s,transform .25s}.ds-enter:hover span{background:#304c3d;transform:translateY(3px)}.ds-button:focus-visible,.ds-link:focus-visible,.ds-input:focus-visible{outline:2px solid var(--copper,#efb093);outline-offset:6px}@media(prefers-reduced-motion:reduce){.ds-enter span{transition:none}}"
    },
    {
      "name": "Visualization Switch",
      "kind": "custom",
      "refersTo": "view-switch",
      "description": "Two compact views share the same biological progress.",
      "html": "<div class=\"ds-switch\" aria-label=\"Visualization mode\"><button class=\"ds-button\" aria-pressed=\"true\"><span></span>Cell view</button><button class=\"ds-button\" aria-pressed=\"false\">Real-world analogy</button></div>",
      "css": ".ds-switch{display:inline-flex;gap:3px;border:1px solid #3c594a99;border-radius:30px;padding:4px;background:#0b1c18aa;backdrop-filter:blur(16px)}.ds-switch button{display:flex;align-items:center;gap:8px;white-space:nowrap;padding:10px 15px;font:400 10px 'DM Sans',sans-serif;color:#9cb3a4;border:0;background:none;border-radius:30px;cursor:pointer;transition:background .25s,color .25s}.ds-switch button[aria-pressed=true]{color:#e6ecdf;background:#30493c}.ds-switch button span{width:4px;height:4px;border-radius:50%;background:#b6d0ac}.ds-button:focus-visible,.ds-link:focus-visible,.ds-input:focus-visible{outline:2px solid var(--copper,#efb093);outline-offset:6px}"
    },
    {
      "name": "Stage Navigation",
      "kind": "nav",
      "refersTo": "stage-navigation",
      "description": "Fine progress line and a warm marker distinguish the current stage.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Cell cycle stages\"><button class=\"ds-button\" aria-current=\"step\"><span class=\"ds-nav-top\"><span>03</span><span class=\"ds-line\"><i></i></span><span class=\"ds-point\"></span></span><span class=\"ds-name\">Metaphase</span></button></nav>",
      "css": ".ds-nav{width:220px}.ds-nav button{width:100%;padding:0;text-align:left;border:0;background:none;cursor:pointer;font-family:'DM Sans',sans-serif}.ds-nav-top{display:flex;align-items:center;gap:10px;color:#e2c0a1;font-size:9px;font-variant-numeric:tabular-nums}.ds-line{height:1px;flex:1;background:#385242}.ds-line i{height:1px;display:block;background:#b5c7a4;width:60%}.ds-point{width:5px;height:5px;border:1px solid #e5c7a0;border-radius:50%;background:#e5c7a0;box-shadow:0 0 12px #d2c69c66}.ds-name{display:inline-block;margin-top:14px;font-size:12px;color:#9ab19e;transition:color .2s}.ds-nav button:hover .ds-name,.ds-nav button[aria-current=step] .ds-name{color:#edf0dd}.ds-button:focus-visible,.ds-link:focus-visible,.ds-input:focus-visible{outline:2px solid var(--copper,#efb093);outline-offset:6px}"
    },
    {
      "name": "Timeline Scrubber",
      "kind": "input",
      "refersTo": "timeline-scrubber",
      "description": "Directly draggable fine track; native range keyboard input remains available.",
      "html": "<input class=\"ds-input ds-scrub\" type=\"range\" min=\"0\" max=\"7.3\" step=\"0.005\" value=\"3.3\" aria-label=\"Scrub through the complete cell cycle\"/>",
      "css": ".ds-scrub{appearance:none;width:100%;height:3px;margin:16px 0;background:transparent;cursor:ew-resize;accent-color:var(--copper,#efb093)}.ds-scrub::-webkit-slider-runnable-track{height:1px;background:#466147}.ds-scrub::-webkit-slider-thumb{appearance:none;width:7px;height:7px;margin-top:-3px;background:#d8c5a7;border-radius:50%;cursor:ew-resize}.ds-scrub::-moz-range-track{height:1px;background:#466147}.ds-scrub::-moz-range-thumb{width:7px;height:7px;border:0;background:#d8c5a7;border-radius:50%}.ds-button:focus-visible,.ds-link:focus-visible,.ds-input:focus-visible{outline:2px solid var(--copper,#efb093);outline-offset:6px}"
    },
    {
      "name": "Spatial Structure Label",
      "kind": "custom",
      "refersTo": "spatial-label",
      "description": "Flat visual equivalent of the camera-facing 3D label; application uses mesh picking and separate keyboard equivalents.",
      "html": "<button class=\"ds-button ds-label\"><span></span>Spindle fibres</button>",
      "css": ".ds-label{display:flex;align-items:center;gap:4px;white-space:nowrap;font:400 11.52px sans-serif;height:28px;padding:0 8px;color:#edf3e6;background:#10291f;border:1px solid #557564;border-radius:0;cursor:pointer}.ds-label>span{width:3px;height:3px;background:var(--copper,#efb093);border-radius:50%}.ds-label:hover{cursor:pointer}.ds-label:focus-visible{outline:2px solid var(--copper,#efb093);outline-offset:6px}"
    },
    {
      "name": "Structure Detail",
      "kind": "custom",
      "refersTo": "structure-detail",
      "description": "Flat visual equivalent of the 3D description plaque; header, body and mesh close control occupy separate reading areas.",
      "html": "<aside class=\"ds-detail\"><div class=\"ds-detail-header\"><span class=\"ds-detail-dot\"></span><h2>Spindle fibres</h2></div><button class=\"ds-close\" aria-label=\"Close structure detail\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"m6 6 12 12M18 6 6 18\"/></svg></button><p>Structures that guide chromosome movement during mitosis.</p></aside>",
      "css": ".ds-detail{position:relative;width:300px;max-width:75vw;padding:15px 13px 14px;background:#10291f;color:#edf3e6;border:1px solid #557564;border-radius:0;font-family:sans-serif}.ds-detail-header{display:flex;align-items:center;gap:6px;padding-right:36px;min-height:20px}.ds-detail-dot{display:block;flex:none;width:4px;height:4px;background:var(--copper,#efb093);border-radius:50%}.ds-detail h2{margin:0;font:500 15.5px/19px sans-serif}.ds-detail p{font:400 13px/17.5px sans-serif;color:#d8e4d1;margin:20px 0 0}.ds-close{position:absolute;right:6px;top:6px;display:grid;place-items:center;width:42px;height:42px;padding:0;color:#e3e9d8;background:#294936;border:0;border-radius:0;cursor:pointer}.ds-close:hover{cursor:pointer}.ds-close:focus-visible{outline:2px solid var(--copper,#efb093);outline-offset:6px}"
    },
    {
      "name": "Field Notes Surface",
      "kind": "custom",
      "refersTo": "field-notes",
      "description": "Modal reading surface; preview shows its body without opening a modal.",
      "html": "<section class=\"ds-notes\"><h2>A little context.<br/>A lot of life.</h2><p>Six chapters follow an illustrative animal cell from preparation to division.</p><a class=\"ds-link\" href=\"#notes\">Biology reference · OpenStax Biology 2e ↗</a></section>",
